# Local Netlify folder (created by netlify CLI / Netlify Dev)
.netlify

# Dependency directories
node_modules/

# Environment / secret files (never commit)
.env
.env.*
!.env.example

# Build / cache output directories
dist/
build/
.next/
out/
.cache/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
